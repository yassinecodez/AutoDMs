# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instaflow?schema=public"

# NextAuth Authentication
NEXTAUTH_SECRET="some_long_random_nextauth_secret_token_here_32_chars"
NEXTAUTH_URL="http://localhost:3000"

# Redis Connection for BullMQ
REDIS_URL="redis://127.0.0.1:6379"

# Meta Graph API Credentials
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="your_meta_webhook_verify_token"
META_API_VERSION="v24.0"
META_CONFIG_ID="your_meta_config_id_from_app_console"

# 32-character key for encrypting long-lived Facebook Page Access Tokens
ENCRYPTION_KEY="abcdefghijklmnopqrstuvwxyz012345"
